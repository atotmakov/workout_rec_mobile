// Triggers and adapters between Logic.gs and the spreadsheet
// (contracts/apps-script.md). Tested with fakes in apps-script/tests/code.test.mjs.
//
// SPREADSHEET_ID, SCRIPT_VERSION and DURATION_FORMULA come from Config.gs, generated by the app on upload.
//
// Simple triggers (onEdit, onSelectionChange) must use e.source / e.range only: they cannot
// call services that need authorization, such as SpreadsheetApp.openById. They therefore work
// before "Enable automation" is approved. doGet, dailyJob and logMetadata run authorized and
// open the spreadsheet by ID.

const LOG_SHEET = 'log';
const REC_SHEET = 'rec';
const DRILL_COLUMN = 2; // log column B
const DATE_COLUMN = 1; // log column A

const ENABLE_TEXTS = {
  en: {
    title: 'Workout Rec automation is on',
    body: 'New workout days will now be added automatically every night. You can close this page and return to the app.',
  },
  ru: {
    title: 'Автоматизация Workout Rec включена',
    body: 'Новые дни тренировок теперь добавляются автоматически каждую ночь. Можно закрыть эту страницу и вернуться в приложение.',
  },
};

/** Auto-fill log rows (spec "Attached automation"). */
function onEdit(e) {
  const range = e.range;
  const sheet = range.getSheet();
  if (sheet.getName() !== LOG_SHEET || range.columnStart !== DRILL_COLUMN) return;
  const value = e.value;
  if (value === undefined || value === '') return; // multi-cell edit or deletion

  const row = range.rowStart;
  const now = new Date();
  const columnB = sheet.getRange(1, DRILL_COLUMN, row, 1).getValues().map(function (r) { return r[0]; });
  autoFillPlan(columnB, row).forEach(function (fillRow) {
    sheet.getRange(fillRow, DRILL_COLUMN).setValue(value);
    setIfEmpty_(sheet.getRange(fillRow, DATE_COLUMN), now);
  });
  setIfEmpty_(sheet.getRange(row, DATE_COLUMN), now);

  const rec = e.source.getSheetByName(REC_SHEET);
  if (rec) rec.getRange('A1').setValue(value);
}

/** Follow selection: show the selected exercise's history in rec. */
function onSelectionChange(e) {
  const range = e.range;
  const sheet = range.getSheet();
  if (sheet.getName() !== LOG_SHEET || range.getColumn() !== DRILL_COLUMN || range.getRow() < 2) return;
  const value = range.getValue();
  if (value === '' || value === null || value === undefined) return;
  const rec = e.source.getSheetByName(REC_SHEET);
  if (rec) rec.getRange('A1').setValue(value);
}

/** "Enable automation" page: installs the daily schedule once and records that it is on. */
function doGet(e) {
  const lang = e && e.parameter && e.parameter.lang === 'ru' ? 'ru' : 'en';
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const installed = ScriptApp.getProjectTriggers().some(function (t) {
    return t.getHandlerFunction() === 'dailyJob';
  });
  if (!installed) {
    ScriptApp.newTrigger('dailyJob').timeBased().everyDays(1).atHour(3).create();
  }
  setMetadata_(ss, 'workout_rec.automation_enabled_at', new Date().toISOString());

  const template = HtmlService.createTemplateFromFile('Enable');
  template.lang = lang;
  template.texts = ENABLE_TEXTS[lang];
  return template.evaluate().setTitle(ENABLE_TEXTS[lang].title);
}

/**
 * Nightly (feature 007): one workout row per log day, durations as the spreadsheet's formula, then a
 * marker. The balance is written only into a spreadsheet the app has not converted yet.
 */
function dailyJob() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const timeZone = ss.getSpreadsheetTimeZone();
  const toDayKey = function (date) { return Utilities.formatDate(date, timeZone, 'yyyy-MM-dd'); };

  const logRows = dataRows_(ss.getSheetByName(LOG_SHEET));
  const workoutSheet = ss.getSheetByName('workout');
  const plan = workoutRowsPlan(logRows, dataRows_(workoutSheet), toDayKey);
  plan.removals.forEach(function (row) {
    workoutSheet.deleteRow(row);
  });
  plan.formulaRows.forEach(function (row) {
    workoutSheet.getRange(row, 2).setFormula(DURATION_FORMULA);
  });
  plan.appends.forEach(function (row) {
    workoutSheet.appendRow([row[0], DURATION_FORMULA, row[1]]);
  });

  const balanceCell = ss.getSheetByName('balance').getRange('A1');
  if (balanceCell.getFormula() === '') {
    const moneyWorkouts = dataRows_(ss.getSheetByName('money')).map(function (r) { return r[1]; });
    const aloneFlags = dataRows_(workoutSheet)
      .filter(function (r) { return r.join('') !== ''; })
      .map(function (r) { return r[2]; });
    balanceCell.setValue(balance(moneyWorkouts, aloneFlags));
  }

  setMetadata_(ss, 'workout_rec.last_daily_run', new Date().toISOString());
}

/** Show status: print the app's status markers to the Execution log. Read-only. */
function logMetadata() {
  const ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  const entries = ss.getDeveloperMetadata().map(function (m) {
    return { key: m.getKey(), value: m.getValue() };
  });
  console.log(formatMetadata(entries));
}

function setIfEmpty_(range, value) {
  if (range.getValue() === '') range.setValue(value);
}

/** All rows except the header. */
function dataRows_(sheet) {
  return sheet.getDataRange().getValues().slice(1);
}

/** Each key appears at most once (contracts/spreadsheet.md). */
function setMetadata_(ss, key, value) {
  const existing = ss.createDeveloperMetadataFinder().withKey(key).find();
  if (existing.length > 0) {
    existing[0].setValue(value);
  } else {
    ss.addDeveloperMetadata(key, value, SpreadsheetApp.DeveloperMetadataVisibility.DOCUMENT);
  }
}
